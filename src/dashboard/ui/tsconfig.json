{
  // Browser UI for `sandcastle dashboard`, bundled by esbuild (tsup), so it
  // resolves modules like a bundler and sees the DOM. Excluded from the root
  // project; `npm run typecheck` checks both.
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // projection.ts pulls in RunEvents.ts, which uses Node types.
    "types": ["node"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["."],
  "exclude": []
}
